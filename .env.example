# Optional environment for scripts/run_reference_investigation.py.
# Every value has a default inside the repository, so none of these is required:
# leave them all commented out to investigate the shipped corpus.
#
# Copy this file to .env and uncomment what you need.

# Directory holding the corpus captures.
#MADRIGAL_CORPUS_DIR=tests/corpus

# Rule applied by the investigation script.
#MADRIGAL_RULE=examples/corpus_rule_v1.json

# Action journal correlated with the requests.
#MADRIGAL_JOURNAL=tests/corpus/corpus_journal.md

# Where the Markdown write-up is written.
#MADRIGAL_REPORT=docs/REFERENCE_INVESTIGATION.md
