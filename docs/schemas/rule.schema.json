{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Pavel1778/madrigal-protocol-lab/docs/schemas/rule.schema.json",
  "title": "Interpretation rule",
  "description": "Declarative description of how to frame a directional stream and read fields from each message. Owned by the Protocol engine. A rule is versioned: any change that affects framing or field reading bumps rule_version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["rule_id", "fields"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "rule_id": { "type": "string", "minLength": 1 },
    "rule_version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "direction": { "type": "string", "enum": ["A_to_B", "B_to_A"] }
      }
    },
    "framing": { "$ref": "#/$defs/framing" },
    "fields": {
      "type": "array",
      "items": { "$ref": "#/$defs/field" }
    }
  },
  "$defs": {
    "framing": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["length_prefixed", "fixed_size", "marker_based", "manual"]
        },
        "length_offset": { "type": "integer", "minimum": 0 },
        "length_size": { "type": "integer", "minimum": 1 },
        "byte_order": { "type": "string", "enum": ["big", "little"] },
        "length_covers": {
          "type": "string",
          "enum": ["payload", "payload_and_length_field", "entire_message"],
          "description": "What the length value counts. payload: total = length_offset + length_size + value. payload_and_length_field: total = length_offset + value. entire_message: total = value. Default when absent: payload."
        },
        "length_includes_payload": {
          "type": "boolean",
          "deprecated": true,
          "description": "Deprecated in favour of length_covers. true maps to entire_message, false maps to payload."
        },
        "size": { "type": "integer", "minimum": 0 },
        "start_bytes": {},
        "end_bytes": {},
        "include_markers": { "type": "boolean" },
        "messages": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["offset", "length"],
            "properties": {
              "offset": { "type": "integer", "minimum": 0 },
              "length": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "offset": { "type": "integer", "minimum": 0, "default": 0 },
        "type": {
          "type": "string",
          "enum": [
            "uint8", "uint16", "uint32", "int8", "int16", "int32",
            "bytes", "enum", "bitmask", "string", "array", "padding",
            "checksum", "computed", "conditional"
          ]
        },
        "byte_order": { "type": "string", "enum": ["big", "little"] },
        "length": { "type": "integer", "minimum": 0 },
        "enum": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "hypothesis": {
          "type": "boolean",
          "description": "True when the field name or meaning is an assumption, not an observation."
        },
        "expected": { "type": "array" },
        "missing_ok": { "type": "boolean" },
        "bit_offset": { "type": "integer", "minimum": 0 },
        "bit_length": { "type": "integer", "minimum": 1 },
        "encoding": { "type": "string", "enum": ["ascii", "utf-8", "latin-1"] },
        "terminated": { "type": "boolean" },
        "element_type": {
          "type": "string",
          "enum": ["uint8", "uint16", "uint32", "int8", "int16", "int32", "bytes"]
        },
        "element_length": { "type": "integer", "minimum": 0 },
        "count": { "type": "integer", "minimum": 0 },
        "count_field": { "type": "string", "minLength": 1 },
        "algorithm": { "type": "string", "enum": ["xor", "sum", "crc8", "crc16"] },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "expression": { "$ref": "#/$defs/expression" },
        "condition": { "$ref": "#/$defs/condition" },
        "field": { "$ref": "#/$defs/field" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "bitmask" } }, "required": ["type"] },
          "then": { "required": ["bit_length"] }
        },
        {
          "if": { "properties": { "type": { "const": "string" } }, "required": ["type"] },
          "then": { "anyOf": [{ "required": ["length"] }, { "required": ["terminated"] }] }
        },
        {
          "if": { "properties": { "type": { "const": "array" } }, "required": ["type"] },
          "then": {
            "required": ["element_type"],
            "anyOf": [{ "required": ["count"] }, { "required": ["count_field"] }]
          }
        },
        {
          "if": { "properties": { "type": { "const": "padding" } }, "required": ["type"] },
          "then": { "required": ["length"] }
        },
        {
          "if": { "properties": { "type": { "const": "checksum" } }, "required": ["type"] },
          "then": { "required": ["algorithm"] }
        },
        {
          "if": { "properties": { "type": { "const": "computed" } }, "required": ["type"] },
          "then": { "required": ["expression"] }
        },
        {
          "if": { "properties": { "type": { "const": "conditional" } }, "required": ["type"] },
          "then": { "required": ["condition", "field"] }
        }
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "op"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "op": { "type": "string", "enum": ["eq", "ne", "bit_set", "bit_clear", "gt", "lt"] },
        "value": {}
      }
    },
    "expression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op"],
      "properties": {
        "op": {
          "type": "string",
          "enum": ["sum_of_lengths", "sum_of_values", "const", "add", "sub", "xor"]
        },
        "fields": { "type": "array", "items": { "type": "string" } },
        "value": { "type": "integer" }
      }
    }
  }
}
